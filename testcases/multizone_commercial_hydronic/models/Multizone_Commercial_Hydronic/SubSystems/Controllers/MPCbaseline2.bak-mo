within INFRAX.SubSystems.Controllers;
model MPCbaseline2 "hybridGEOTABS MPC baseline"
  INFRAX.hG_MPC_baseline.MpcEnvelopeVentTabsRBCSim mpc(
    maxIter=250, conTol = 1e-1,
      stateEstimationType=UnitTests.MPC.BaseClasses.StateEstimationType.Perfect)
    annotation (Placement(transformation(extent={{-58,-40},{-38,-20}})));
  Real heaMod;
  Real cooMod;
  Real tabs3wayVal;
  Real p05signal;
  Real[15] vav_signal_supply;
  Real[15] vav_signal_extract;
  Boolean fanOn;
  Integer P08P09;
  Integer P06;
  Real P13;
  Boolean HPOn;
  Real THPSet;
  DataBus dataBus annotation (Placement(transformation(extent={{-120,-20},{-80,20}}),
        iconTransformation(extent={{-110,-10},{-90,10}})));
  SignalBus signalBus annotation (Placement(transformation(extent={{80,-20},{120,
            20}}), iconTransformation(extent={{90,-10},{110,10}})));
  Air.Comfort.Limits temLim(typeLimit=2, nZones=14,
    maxOT=20 + 273.15)
    "Model that computes the building limits and calculates the discomfort"
    annotation (Placement(transformation(extent={{-60,-10},{-40,12}})));
  SubControllers.Valves.Tavg_of_floors avgFlrT
    "Model that computes the average temperature of the different floors"
    annotation (Placement(transformation(extent={{-100,60},{-80,80}})));
  inner IDEAS.BoundaryConditions.SimInfoManager sim(incAndAziInBus={{IDEAS.Types.Tilt.Ceiling,
        0},{IDEAS.Types.Tilt.Wall,IDEAS.Types.Azimuth.S},{IDEAS.Types.Tilt.Wall,
        IDEAS.Types.Azimuth.W},{IDEAS.Types.Tilt.Wall,IDEAS.Types.Azimuth.N},{
        IDEAS.Types.Tilt.Wall,IDEAS.Types.Azimuth.E}})
    annotation (Placement(transformation(extent={{-100,80},{-80,100}})));
  Modelica.Blocks.Sources.RealExpression TABSmode[2](y={heaMod,cooMod})
    annotation (Placement(transformation(extent={{-20,34},{0,54}})));
  Modelica.Blocks.Sources.RealExpression p05(y=p05signal)
    annotation (Placement(transformation(extent={{-20,16},{0,36}})));
  Components.Clock           clock
    annotation (Placement(transformation(extent={{-60,80},{-40,100}})));
  Modelica.Blocks.Sources.RealExpression AHUFans[2](y=if (((clock.hour >= 5 and
        clock.hour < 20) and (clock.weekDay) < 6) and (mpc.dp_fanSup > 15 and mpc.dp_fanRet > 15))
         == true then {mpc.dp_fanSup,mpc.dp_fanRet} else {0,0})
    "setpoint for AHU fans"
    annotation (Placement(transformation(extent={{-20,78},{2,98}})));
  Modelica.Blocks.Sources.RealExpression vav_signal[2,15](y={vav_signal_supply,
        vav_signal_extract})
    annotation (Placement(transformation(extent={{-20,-28},{0,-8}})));
  SubControllers.HP_ByPass hP_ByPass
    annotation (Placement(transformation(extent={{-10,-80},{10,-60}})));
  Modelica.Blocks.Sources.IntegerConstant p7Con(k=1) "P07 is always on"
    annotation (Placement(transformation(extent={{20,60},{40,80}})));
  Modelica.Blocks.Sources.IntegerExpression P08P09signal(y=P08P09)
    "Pumps 08 and 09 signal"
    annotation (Placement(transformation(extent={{-20,2},{2,22}})));
  Modelica.Blocks.Sources.RealExpression p13(y=P13)
    annotation (Placement(transformation(extent={{-20,-44},{0,-24}})));
  Modelica.Blocks.Math.RealToInteger P04
    annotation (Placement(transformation(extent={{20,-60},{40,-40}})));
  Modelica.Blocks.Math.Gain P13_nom(k=14.5*9804.139432)
    "nominal pressure rise of P13"
    annotation (Placement(transformation(extent={{56,-40},{68,-28}})));
  SubControllers.Situations.Situations ctCon
    "Model that includes the control logic of the cooling tower"
    annotation (Placement(transformation(extent={{-56,-80},{-36,-60}})));
  Modelica.Blocks.Sources.IntegerExpression P06signal(y=P06)
    "P06 signal"
    annotation (Placement(transformation(extent={{-20,-14},{2,6}})));
  SubControllers.HP_baseline hP_baseline
    annotation (Placement(transformation(extent={{-60,44},{-40,64}})));
  Modelica.Blocks.Sources.RealExpression TSet(y=THPSet)
    annotation (Placement(transformation(extent={{-60,24},{-40,44}})));
  Modelica.Blocks.Sources.BooleanExpression buiMode[2](y={heaMod > 0.5,cooMod >
        0.5}) annotation (Placement(transformation(extent={{16,2},{36,22}})));
  Modelica.Blocks.Sources.RealExpression TABS3way(y=tabs3wayVal)
    annotation (Placement(transformation(extent={{48,40},{68,60}})));
  IDEAS.Controls.Continuous.LimPID PI3WayHea(
    controllerType=Modelica.Blocks.Types.SimpleController.PI,
    Td=0,
    k=5,
    Ti(displayUnit="min") = 60,
    y_start=1) "Controller for 3-way valve"
    annotation (Placement(transformation(extent={{-88,-34},{-68,-14}})));
  Modelica.Blocks.Sources.RealExpression TSetTABS(y=mpc.TTabsSup)
    annotation (Placement(transformation(extent={{-182,-22},{-162,-2}})));
  Modelica.Blocks.Interfaces.RealInput uSta[mpc.nSta]
    annotation (Placement(transformation(extent={{-120,-110},{-80,-70}})));
  IDEAS.Controls.Continuous.LimPID PIP05(
    initType=Modelica.Blocks.Types.InitPID.InitialState,
    controllerType=Modelica.Blocks.Types.SimpleController.PI,
    Td=0,
    reverseAction=true,
    k=10,
    Ti(displayUnit="s") = 45) "Controller for TABS pump"
    annotation (Placement(transformation(extent={{-144,-38},{-124,-18}})));
  Modelica.Blocks.Sources.Constant const1(k=150)
    annotation (Placement(transformation(extent={{-160,-198},{-140,-178}})));
  Modelica.Blocks.Logical.GreaterEqual solDirMaxSWE[3]
    annotation (Placement(transformation(extent={{-112,-190},{-92,-170}})));
  Modelica.Blocks.Math.BooleanToReal scrnCtrl[3] "Screen control signal"
    annotation (Placement(transformation(extent={{-72,-190},{-52,-170}})));
  SubControllers.Pumps.P1 p1_1
    annotation (Placement(transformation(extent={{-88,22},{-68,42}})));
  Modelica.Blocks.Sources.RealExpression p03(y=if HPSignal.y > 1 then 12*
        9806.38 else 5*9806.38)
    annotation (Placement(transformation(extent={{-18,-100},{2,-80}})));
  IDEAS.Controls.Continuous.LimPID con3wayCoo(
    initType=Modelica.Blocks.Types.InitPID.InitialState,
    controllerType=Modelica.Blocks.Types.SimpleController.PI,
    Td=0,
    k=8,
    Ti(displayUnit="s") = 40,
    reverseAction=true) "Controller for 3-way valve of AHU cooling coil"
    annotation (Placement(transformation(extent={{-182,64},{-162,84}})));
  IDEAS.Controls.Continuous.LimPID con3wayHea(
    initType=Modelica.Blocks.Types.InitPID.InitialState,
    controllerType=Modelica.Blocks.Types.SimpleController.PI,
    Td=0,
    Ti(displayUnit="s") = 20,
    k=2,
    reverseAction=false) "Controller for 3-way valve of AHU heating coil"
    annotation (Placement(transformation(extent={{-182,26},{-162,46}})));
  Modelica.Blocks.Sources.RealExpression TSetTABS1(y=mpc.TSup_ahu)
    annotation (Placement(transformation(extent={{-228,48},{-208,68}})));
  Modelica.Blocks.Logical.Switch switch1
    annotation (Placement(transformation(extent={{-142,76},{-122,96}})));
  Modelica.Blocks.Logical.Switch switch3
    annotation (Placement(transformation(extent={{-146,54},{-126,34}})));
  Modelica.Blocks.Logical.Not not1
    annotation (Placement(transformation(extent={{-236,8},{-216,28}})));
  Modelica.Blocks.Logical.Hysteresis hysteresis(
    pre_y_start=true,
    uLow=0,
    uHigh=0.25)       "hysteresis logic for HPs"
    annotation (Placement(transformation(extent={{-278,34},{-258,54}})));
  Modelica.Blocks.Logical.Hysteresis hysteresis1(
    pre_y_start=true,
    uLow=-0.25,
    uHigh=0)          "hysteresis logic for HPs"
    annotation (Placement(transformation(extent={{-278,8},{-258,28}})));
  Modelica.Blocks.Math.Add add(k2=-1)
    annotation (Placement(transformation(extent={{-308,34},{-288,54}})));
  Modelica.Blocks.Sources.Constant closed(k=0)
    "setpoint both for heating and cooling"
    annotation (Placement(transformation(extent={{-124,60},{-136,72}})));
  Modelica.Blocks.Routing.RealPassThrough TRecOut
    annotation (Placement(transformation(extent={{118,-38},{138,-18}})));
  Modelica.Blocks.Routing.IntegerPassThrough
                                          HPSignal
    annotation (Placement(transformation(extent={{126,-78},{146,-58}})));
protected
  IDEAS.Buildings.Components.Interfaces.WeaBus weaBus(numSolBus=sim.numIncAndAziInBus,
      final outputAngles=sim.outputAngles)
    annotation (Placement(transformation(extent={{-160,-170},{-140,-150}}),
        iconTransformation(extent={{90,30},{90,30}})));
equation
    connect(weaBus,sim.weaBus);
//MPC connections
  //HP
  HPOn = mpc.QHP > 2000;
  THPSet = if HPOn then min(max(273.15 + 25, mpc.TCon),273.15+32) else 273.15 + 15;
  //TABS
    //2-way valves
  connect(mpc.y_cca0, signalBus.CCA0_val);
  connect(mpc.y_cca1, signalBus.CCA1_val);
  connect(mpc.y_cca2, signalBus.CCA2_val);
  connect(mpc.y_cca3, signalBus.CCA3_val);
    //2-way MODE valves (1 or 0)
  heaMod = if mpc.QTabsHea > 10000 and abs(mpc.QTabsCoo) < abs(mpc.QTabsHea) then 1 else 0;
  cooMod = if abs(mpc.QTabsCoo) > 10000 and abs(mpc.QTabsCoo) > abs(mpc.QTabsHea) then 1 else 0;
    //3-way valve
  tabs3wayVal = if heaMod < 0.5 and cooMod < 0.5 then 0 else if heaMod > 0.5 then PI3WayHea.y else 1;
    //Pump 05
  p05signal = if abs(mpc.QTabsCoo) > 10000 and cooMod > 0.5 then PIP05.y else 0;
  //Ventilation
    //AHU coils
 // connect(mpc.y_valCooAhu, signalBus.CooCoi_3way_signal);
 // connect(mpc.y_valHeaAhu, signalBus.HeaCoi_3way_signal);
  connect(mpc.y_ahu, signalBus.TW_bypass);
    //Ventilation pumps
  fanOn = mpc.dp_in_Sup > 15 and mpc.dp_in_Ret > 15;
  P08P09 = if abs(mpc.QHeaAhu) > 500 and fanOn and con3wayHea.y > 0 then 1 else 0;
  P13 = if abs(mpc.QCooAhu) > 500 and fanOn and con3wayCoo.y > 0 then 1 else 0;
  P06 = if abs(mpc.QHeaVav) > 200 and fanOn and sum(mpc.y_valHeaVav) > 0 then 1 else 0;
  connect(P08P09signal.y, signalBus.P08_signal);
  connect(P08P09signal.y, signalBus.P09_signal);
    //VAV reheating
  connect(mpc.y_valHeaVav, signalBus.Heacoils_signal);
    //VAV damper
  vav_signal_supply = {
  mpc.y_vav[1],
  mpc.y_vav[2],
  mpc.y_vav[3],
  mpc.y_vav[4],
  mpc.y_vav[5],
  mpc.y_vav[6],
  mpc.y_vav[7],
  mpc.y_vav[8],
  mpc.y_vav[9],
  mpc.y_vav[9],
  mpc.y_vav[10],
  mpc.y_vav[11],
  mpc.y_vav[12],
  mpc.y_vav[13],
  mpc.y_vav[14]};
  vav_signal_extract = {
  mpc.y_vav[1],
  mpc.y_vav[2],
  mpc.y_vav[3],
  mpc.y_vav[4],
  mpc.y_vav[5],
  mpc.y_vav[6],
  mpc.y_vav[7],
  mpc.y_vav[8],
  mpc.y_vav[9],
  mpc.y_vav[10],
  mpc.y_vav[11],
  mpc.y_vav[12],
  mpc.y_vav[13],
  mpc.y_vav[14],
  1};
  connect(temLim.Tavg, signalBus.baseSetpoint) annotation (Line(points={{-39.25,
          2.60769},{28.375,2.60769},{28.375,0},{100,0}}, color={0,0,127},
      visible=false),                                                      Text(
      string="%second",
      index=1,
      extent={{6,3},{6,3}},
      horizontalAlignment=TextAlignment.Left));
  connect(avgFlrT.dataBus, dataBus) annotation (Line(
      points={{-100,70},{-100,0}},
      color={255,204,51},
      thickness=0.5), Text(
      string="%second",
      index=1,
      extent={{-6,3},{-6,3}},
      horizontalAlignment=TextAlignment.Right));
  connect(dataBus.T3rdFlr_SZ,temLim. TSensor[1]) annotation (Line(
      points={{-99.9,0.1},{-90,0.1},{-90,0},{-79.6667,0},{-79.6667,-1.41758},{
          -61.6667,-1.41758}},
      color={255,204,51},
