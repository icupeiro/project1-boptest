within INFRAX.SubSystems.Controllers;
model MPCbaseline_precomputed "hybridGEOTABS MPC baseline"
  Real heaMod;
  Real cooMod;
//  Real tabs3wayVal;
  Real p05signal;
  Real[15] vav_signal_supply;
  Real[15] vav_signal_extract;
  Real[21] vav_3way;
  Boolean fanOn;
  Integer P08P09;
  Integer P06;
  Real P13;
 // Boolean HPOn;
  Real THPSet;
  DataBus dataBus annotation (Placement(transformation(extent={{-120,-20},{-80,20}}),
        iconTransformation(extent={{-110,-10},{-90,10}})));
  SignalBus signalBus annotation (Placement(transformation(extent={{80,-20},{120,
            20}}), iconTransformation(extent={{90,-10},{110,10}})));
  Air.Comfort.Limits temLim(typeLimit=2, nZones=14,
    maxOT=20 + 273.15)
    "Model that computes the building limits and calculates the discomfort"
    annotation (Placement(transformation(extent={{-60,-10},{-40,12}})));
  SubControllers.Valves.Tavg_of_floors avgFlrT
    "Model that computes the average temperature of the different floors"
    annotation (Placement(transformation(extent={{-100,60},{-80,80}})));
  inner IDEAS.BoundaryConditions.SimInfoManager sim(incAndAziInBus={{IDEAS.Types.Tilt.Ceiling,
        0},{IDEAS.Types.Tilt.Wall,IDEAS.Types.Azimuth.S},{IDEAS.Types.Tilt.Wall,
        IDEAS.Types.Azimuth.W},{IDEAS.Types.Tilt.Wall,IDEAS.Types.Azimuth.N},{
        IDEAS.Types.Tilt.Wall,IDEAS.Types.Azimuth.E}})
    annotation (Placement(transformation(extent={{-100,80},{-80,100}})));
  Modelica.Blocks.Sources.RealExpression p05(y=p05signal)
    annotation (Placement(transformation(extent={{-20,16},{0,36}})));
  Components.Clock           clock
    annotation (Placement(transformation(extent={{-60,80},{-40,100}})));
  SubControllers.HP_ByPass hP_ByPass
    annotation (Placement(transformation(extent={{-20,-46},{0,-26}})));
  Modelica.Blocks.Sources.IntegerConstant p7Con(k=1) "P07 is always on"
    annotation (Placement(transformation(extent={{20,60},{40,80}})));
  SubControllers.Situations.Situations ctCon
    "Model that includes the control logic of the cooling tower"
    annotation (Placement(transformation(extent={{-60,-100},{-40,-80}})));
  SubControllers.HP_MPC_baseline
                             hP_MPC_baseline(hysteresis(uLow=0, uHigh=1.5))
    annotation (Placement(transformation(extent={{-60,44},{-40,64}})));
  Modelica.Blocks.Sources.RealExpression TSet(y=THPSet)
    annotation (Placement(transformation(extent={{-20,30},{0,50}})));
  Modelica.Blocks.Sources.Constant const1(k=150)
    annotation (Placement(transformation(extent={{-160,-198},{-140,-178}})));
  Modelica.Blocks.Logical.GreaterEqual solDirMaxSWE[3]
    annotation (Placement(transformation(extent={{-112,-190},{-92,-170}})));
  Modelica.Blocks.Math.BooleanToReal scrnCtrl[3] "Screen control signal"
    annotation (Placement(transformation(extent={{-72,-190},{-52,-170}})));
  SubControllers.Pumps.P1 p1_1
    annotation (Placement(transformation(extent={{-88,22},{-68,42}})));
  Modelica.Blocks.Sources.RealExpression p03(y=if HPSignal.y > 0.5 then 12*
        9806.38 else 3*9806.38)
    annotation (Placement(transformation(extent={{-20,-80},{0,-60}})));
  Modelica.Blocks.Routing.IntegerPassThrough HPSignal
    annotation (Placement(transformation(extent={{128,-124},{148,-104}})));
  Modelica.Blocks.Sources.CombiTimeTable combiTimeTable(
    tableOnFile=true,
    tableName="data",
    fileName="Tuning.txt",
    columns=2:69,
    smoothness=Modelica.Blocks.Types.Smoothness.ConstantSegments,
    extrapolation=Modelica.Blocks.Types.Extrapolation.HoldLastPoint)
    annotation (Placement(transformation(extent={{-20,-20},{0,0}})));
  Modelica.Blocks.Sources.RealExpression vav_signal[2,15](y={vav_signal_supply,
        vav_signal_extract})
    annotation (Placement(transformation(extent={{-20,2},{0,22}})));
  Modelica.Blocks.Sources.RealExpression vav_3way_signal[21](y=vav_3way)
    annotation (Placement(transformation(extent={{-20,-64},{0,-44}})));
  Modelica.Blocks.Sources.RealExpression TABSmode[2](y={heaMod,cooMod})
    annotation (Placement(transformation(extent={{0,82},{20,102}})));
  Modelica.Blocks.Sources.RealExpression p13(y=P13)
    annotation (Placement(transformation(extent={{-90,-104},{-70,-84}})));
  Modelica.Blocks.Math.RealToInteger P04
    annotation (Placement(transformation(extent={{-50,-120},{-30,-100}})));
  Modelica.Blocks.Math.Gain P13_nom(k=14.5*9804.139432)
    "nominal pressure rise of P13"
    annotation (Placement(transformation(extent={{-14,-100},{-2,-88}})));
  Modelica.Blocks.Sources.IntegerExpression P06signal(y=P06)
    "P06 signal"
    annotation (Placement(transformation(extent={{-90,-74},{-68,-54}})));
  Modelica.Blocks.Sources.IntegerExpression P08P09signal(y=P08P09)
    "Pumps 08 and 09 signal"
    annotation (Placement(transformation(extent={{-90,-58},{-68,-38}})));
  Modelica.Blocks.Sources.BooleanExpression buiMode[2](y={heaMod > 0.5,cooMod >
        0.5}) annotation (Placement(transformation(extent={{-54,-40},{-34,-20}})));
  IDEAS.Controls.Continuous.LimPID PI3WayHea(
    controllerType=Modelica.Blocks.Types.SimpleController.PI,
    Td=0,
    k=0.1,
    Ti(displayUnit="s") = 60,
    y_start=1) "Controller for 3-way valve"
    annotation (Placement(transformation(extent={{-140,-36},{-120,-16}})));
  Modelica.Blocks.Sources.RealExpression TTabs(y=combiTimeTable.y[52])
    annotation (Placement(transformation(extent={{-184,-36},{-164,-16}})));
  Modelica.Blocks.Sources.RealExpression tabs3way(y=if heaMod > 0.5 then
        PI3WayHea.y else if cooMod > 0.5 then combiTimeTable.y[41] else 0)
    annotation (Placement(transformation(extent={{-160,0},{-140,20}})));
  Modelica.Blocks.Sources.RealExpression heaCoi_AHU(y=if fanOn then con3wayHea.y
         else 0)
    annotation (Placement(transformation(extent={{-170,20},{-150,40}})));
  Modelica.Blocks.Sources.RealExpression cooCoi_AHU(y=if fanOn then con3wayCoo.y
         else 0)
    annotation (Placement(transformation(extent={{-172,46},{-152,66}})));
  IDEAS.Controls.Continuous.LimPID con3wayHea(
    initType=Modelica.Blocks.Types.InitPID.InitialState,
    controllerType=Modelica.Blocks.Types.SimpleController.PI,
    Td=0,
    Ti(displayUnit="s") = 40,
    k=2,
    reverseAction=false) "Controller for 3-way valve of AHU heating coil"
    annotation (Placement(transformation(extent={{-230,18},{-210,38}})));
  IDEAS.Controls.Continuous.LimPID con3wayCoo(
    initType=Modelica.Blocks.Types.InitPID.InitialState,
    controllerType=Modelica.Blocks.Types.SimpleController.PI,
    Td=0,
    k=5,
    Ti(displayUnit="s") = 40,
    reverseAction=true) "Controller for 3-way valve of AHU cooling coil"
    annotation (Placement(transformation(extent={{-230,54},{-210,74}})));
  Modelica.Blocks.Sources.RealExpression TAHU(y=combiTimeTable.y[54])
    annotation (Placement(transformation(extent={{-282,54},{-262,74}})));
  IDEAS.Controls.Continuous.LimPID conHeaCoi[14](
    controllerType=Modelica.Blocks.Types.SimpleController.PI,
    each k=2,
    each Ti=100,
    each reset=IDEAS.Types.Reset.Disabled)
    "Controller for heating coils in air ducts"
    annotation (Placement(transformation(extent={{-140,-78},{-120,-58}})));
  Modelica.Blocks.Sources.RealExpression TAirSup[14](y={combiTimeTable.y[54 + i]
        for i in 1:14})
    annotation (Placement(transformation(extent={{-180,-78},{-160,-58}})));
  Modelica.Blocks.Sources.RealExpression TAirSupSet[14](y={if not1[i].y then 273.15
         + 24 else TAirSup[i].y for i in 1:14})
    annotation (Placement(transformation(extent={{-174,-96},{-154,-76}})));
  Modelica.Blocks.Logical.Hysteresis hysteresis[14](
    pre_y_start=true,
    uLow=0.1,
    uHigh=0.6) "hysteresis logic for HPs"
    annotation (Placement(transformation(extent={{-208,-124},{-188,-104}})));
  Modelica.Blocks.Logical.Not not1[14] "heating mode conditions"
    annotation (Placement(transformation(extent={{-178,-124},{-158,-104}})));
  Modelica.Blocks.Sources.RealExpression hysCheck[14](y={temLim.TSensor[i] -
        temLim.ctrlLimits.limValue[2, 4] for i in 1:14})
    annotation (Placement(transformation(extent={{-186,-94},{-206,-74}})));
  IDEAS.Controls.Continuous.LimPID conP05(
    initType=Modelica.Blocks.Types.InitPID.InitialState,
    controllerType=Modelica.Blocks.Types.SimpleController.PI,
    Td=0,
    reverseAction=true,
    k=1,
    Ti(displayUnit="s") = 60) "Controller for TABS pump"
    annotation (Placement(transformation(extent={{-212,-56},{-192,-36}})));
  Modelica.Blocks.Logical.Hysteresis hysteresis1(
    pre_y_start=true,
    uLow=-0.5,
    uHigh=0.25) "hysteresis logic for HPs"
    annotation (Placement(transformation(extent={{-160,86},{-140,106}})));
  Modelica.Blocks.Sources.RealExpression tabsHys(y=dataBus.T24 - combiTimeTable.y[
        52])
    annotation (Placement(transformation(extent={{-202,86},{-182,106}})));
  Modelica.Blocks.Logical.Not not2 "heating mode conditions"
    annotation (Placement(transformation(extent={{-130,86},{-110,106}})));
  Modelica.Blocks.Sources.RealExpression AHUFansignals[2](y={combiTimeTable.y[1],
        min(combiTimeTable.y[2], combiTimeTable.y[1])})
    annotation (Placement(transformation(extent={{-18,60},{2,80}})));
  Modelica.Blocks.Logical.Hysteresis hysteresis2(
    pre_y_start=true,
    uLow=-0.25,
    uHigh=0.5)  "hysteresis logic for HPs"
    annotation (Placement(transformation(extent={{-160,114},{-140,134}})));
protected
  IDEAS.Buildings.Components.Interfaces.WeaBus weaBus(numSolBus=sim.numIncAndAziInBus,
      final outputAngles=sim.outputAngles)
    annotation (Placement(transformation(extent={{-160,-170},{-140,-150}}),
        iconTransformation(extent={{90,30},{90,30}})));
equation
  vav_signal_supply = {
  combiTimeTable.y[6],
combiTimeTable.y[7],
combiTimeTable.y[8],
combiTimeTable.y[9],
combiTimeTable.y[10],
combiTimeTable.y[11],
combiTimeTable.y[12],
combiTimeTable.y[13],
combiTimeTable.y[14],
combiTimeTable.y[14],
combiTimeTable.y[15],
combiTimeTable.y[16],
combiTimeTable.y[17],
combiTimeTable.y[18],
combiTimeTable.y[19]};
  vav_signal_extract = {
  combiTimeTable.y[6],
combiTimeTable.y[7],
combiTimeTable.y[8],
combiTimeTable.y[9],
combiTimeTable.y[10],
combiTimeTable.y[11],
combiTimeTable.y[12],
combiTimeTable.y[13],
combiTimeTable.y[14],
combiTimeTable.y[15],
combiTimeTable.y[16],
combiTimeTable.y[17],
combiTimeTable.y[18],
combiTimeTable.y[19],
  1};
  vav_3way = {
conHeaCoi[1].y,
combiTimeTable.y[21],
combiTimeTable.y[22],
conHeaCoi[2].y,
conHeaCoi[3].y,
conHeaCoi[4].y,
conHeaCoi[5].y,
conHeaCoi[6].y,
conHeaCoi[7].y,
conHeaCoi[8].y,
conHeaCoi[9].y,
conHeaCoi[10].y,
conHeaCoi[11].y,
combiTimeTable.y[33],
combiTimeTable.y[34],
conHeaCoi[12].y,
conHeaCoi[13].y,
conHeaCoi[14].y,
combiTimeTable.y[38],
combiTimeTable.y[39],
combiTimeTable.y[40]};
    connect(weaBus,sim.weaBus);
//MPC connections
  //HP
 // HPOn = mpc.QHP > 2000;
  THPSet = max(min(combiTimeTable.y[46],273.15+32),273.15+25);
  //TABS
    //2-way valves
    //2-way MODE valves (1 or 0)
  //heaMod = if combiTimeTable.y[47] > 25000 then 1 else 0;
  //cooMod = if combiTimeTable.y[47] < 25000 then 1 else 0;
  heaMod = if not2.y and combiTimeTable.y[47] > 0 then 1 else 0;
  cooMod = if hysteresis2.y and combiTimeTable.y[47] < 0  then 1 else 0;
    //3-way valve
    //Pump 05
  p05signal = if cooMod > 0.5 then conP05.y else 0;
  //Ventilation
    //AHU coils
 // connect(mpc.y_valCooAhu, signalBus.CooCoi_3way_signal);
 // connect(mpc.y_valHeaAhu, signalBus.HeaCoi_3way_signal);
//  connect(mpc.y_ahu, signalBus.TW_bypass);
    //Ventilation pumps
  fanOn = if combiTimeTable.y[1] > 15 or combiTimeTable.y[2] > 15 then true else false;
  P08P09 = if abs(combiTimeTable.y[48])- abs(combiTimeTable.y[49]) > 0 and fanOn then 1 else 0;
  P13 = if abs(combiTimeTable.y[48]) - abs(combiTimeTable.y[49]) < 0 and fanOn then 1 else 0;
  P06 = if abs(combiTimeTable.y[50]) > 0 and fanOn then 1 else 0;

    //VAV reheating
//  connect(mpc.y_valHeaVav, signalBus.Heacoils_signal);
    //VAV damper

  connect(temLim.Tavg, signalBus.baseSetpoint) annotation (Line(points={{-39.25,
          2.60769},{28.375,2.60769},{28.375,0},{100,0}}, color={0,0,127},
      visible=false),                                                      Text(
      string="%second",
      index=1,
      extent={{6,3},{6,3}},
      horizontalAlignment=TextAlignment.Left));
  connect(avgFlrT.dataBus, dataBus) annotation (Line(
      points={{-100,70},{-100,0}},
      color={255,204,51},
      thickness=0.5), Text(
      string="%second",
      index=1,
      extent={{-6,3},{-6,3}},
      horizontalAlignment=TextAlignment.Right));
  connect(dataBus.T3rdFlr_SZ,temLim. TSensor[1]) annotation (Line(
      points={{-99.9,0.1},{-90,0.1},{-90,0},{-79.6667,0},{-79.6667,-1.41758},{
          -61.6667,-1.41758}},
      color={255,204,51},
      thickness=0.5), Text(
      string="%first",
      index=-1,
      extent={{-6,3},{-6,3}},
      horizontalAlignment=TextAlignment.Right));
   connect(dataBus.T3rdFlr_MTR,temLim. TSensor[2]) annotation (Line(
