        i]/air.m_nominal_supply_vav[i] + (1 - air.m_nominal_supply_vav_min[i]/
        air.m_nominal_supply_vav[i])*dummy_vav[i].y for i in 1:15})
    annotation (Placement(transformation(extent={{-40,-92},{-12,-72}})));
